# Copy to .env.local and fill in once the Sanity project exists.
# Until these are set, the site renders from the seed data in lib/content/.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only, for /api/sponsor-inquiry when that flow is reinstated (see README).
SANITY_WRITE_TOKEN=
RESEND_API_KEY=
SPONSOR_INBOX=
